# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://YOUR_USERNAME@localhost:5432/travel_planner?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required in production and must be at least 32 characters. The app refuses to
# start in production rather than signing tokens with an insecure fallback.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── Locale / currency ───────────────────────────────────────────────────────
# NEXT_PUBLIC_ vars are read in the browser for display formatting.
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_LOCALE="en-IN"

# ─── AI provider ─────────────────────────────────────────────────────────────
# Which provider powers the assistant and agent reasoning: gemini | openai
AI_PROVIDER="gemini"

# Google Gemini — free tier, no credit card. https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Fast (~1s). Use gemini-3.6-flash for deeper reasoning but 10-20s replies.
GEMINI_MODEL="gemini-3.5-flash-lite"

# ─── OpenAI (multi-agent system) ─────────────────────────────────────────────
# Without a valid key the orchestrator runs its mock pipeline instead.
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# ─── Web search: current prices, entry fees, events (with citations) ─────────
# Tavily — free tier, no credit card. https://tavily.com
# Without this key, research falls back to model knowledge and every figure it
# produces is labelled ESTIMATED with no source.
TAVILY_API_KEY="tvly-your-tavily-api-key"

# ─── Maps / places / routing (OpenStreetMap stack — all keyless) ─────────────
# Overpass: real POIs (forts, museums, restaurants) with coordinates + hours.
OVERPASS_URL="https://overpass-api.de/api/interpreter"
# Nominatim: geocoding. OSM policy REQUIRES an identifying User-Agent with
# contact info — requests without one get blocked.
NOMINATIM_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="ai-travel-planner/1.0 (+http://localhost:3000)"
# OSRM: real road distances and drive times. The public demo server is
# rate-limited; self-host for heavy use.
OSRM_BASE_URL="https://router.project-osrm.org"

# ─── Weather (keyless) ───────────────────────────────────────────────────────
# Open-Meteo needs no key; listed here only for completeness.
# https://open-meteo.com

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
# Without a key, OTP and reset emails are logged to the console in dev.
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="Travel Planner"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── OTP / password reset ────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES="10"
PASSWORD_RESET_EXPIRY_MINUTES="60"

# ─── Build isolation (optional) ──────────────────────────────────────────────
# Set to build into a separate directory so `npm run build` does not clobber a
# running `npm run dev` server's .next cache.
# NEXT_DIST_DIR=".next-ci"
